//@version=6
indicator("Self-Adaptive Trend Signals [AlgoAlpha]", "AlgoAlpha - Self-Learning Adaptive", overlay = true, max_boxes_count = 100, max_labels_count = 500, max_lines_count = 20, max_bars_back = 5000)

// inputs

string GRP_SUPERTREND = "Trend Line"
string GRP_ADAPTIVE = "Learning Settings"
string GRP_APPEARANCE = "Appearance"
string GRP_PROFILE = "Pullback Map"
string GRP_DASHBOARD = "Quick Read"
int PROFILE_BIN_COUNT = 16

float sourceInput = input.source(hl2, "Price Source", group = GRP_SUPERTREND, tooltip = "Price used as the middle of the trend line calculation. Most users can leave this unchanged.")
int atrLengthInput = input.int(10, "Normal Move Length", minval = 2, maxval = 200, group = GRP_SUPERTREND, tooltip = "Bars used to judge what a normal price move looks like. Higher values change more slowly; lower values react faster.")
float fallbackFactorInput = input.float(3.0, "Starting Room", minval = 0.25, maxval = 10.0, step = 0.05, group = GRP_SUPERTREND, tooltip = "Temporary pullback room used while the script is still learning. A value of 3 means roughly three normal price moves.")

float quantileInput = input.float(85.0, "Pullback Coverage", minval = 50.0, maxval = 99.0, step = 1.0, group = GRP_ADAPTIVE, tooltip = "How much past pullback behavior the trend line should allow. 85 means it aims to leave room for about 85 out of 100 past pullbacks.")
int sampleLengthInput = input.int(150, "Learning Memory", minval = 20, maxval = 1000, group = GRP_ADAPTIVE, tooltip = "Number of recent pullback readings remembered separately for uptrends and downtrends. More readings are steadier but adjust more slowly.")
int minimumSamplesInput = input.int(25, "Examples Until Ready", minval = 5, maxval = 250, group = GRP_ADAPTIVE, tooltip = "Pullback readings needed before the learned room is fully trusted. Before then, the script mixes its learning with Starting Room.")
int factorSmoothingInput = input.int(5, "Learning Smoothness", minval = 1, maxval = 50, group = GRP_ADAPTIVE, tooltip = "How smoothly the learned pullback room changes. Use 1 for immediate changes; higher values change more gradually.")
float minimumFactorInput = input.float(0.75, "Minimum Room", minval = 0.1, maxval = 10.0, step = 0.05, inline = "factorBounds", group = GRP_ADAPTIVE)
float maximumFactorInput = input.float(6.0, "Maximum Room", minval = 0.25, maxval = 20.0, step = 0.05, inline = "factorBounds", group = GRP_ADAPTIVE, tooltip = "Minimum Room prevents the trend line from becoming too tight. Maximum Room prevents it from becoming too wide. Both are measured in normal price moves.")

bool showBandsInput = input.bool(true, "Show Trend Line", group = GRP_APPEARANCE, tooltip = "Shows the main trailing trend line and a thinner inner bounce line closer to price.")
bool showFillInput = input.bool(true, "Show Trend Zone", group = GRP_APPEARANCE, tooltip = "Shades the space between price and the trend line, with a stronger trail between the main line and the inner bounce line. Green means up; red means down.")
bool showSignalsInput = input.bool(true, "Show Markers", group = GRP_APPEARANCE, tooltip = "Shows large markers when the trend changes and small arrows when price enters the bounce zone, then closes back out toward price.")
bool colorBarsInput = input.bool(false, "Color Bars", group = GRP_APPEARANCE, tooltip = "Colors candles green during uptrends and red during downtrends.")
int lineWidthInput = input.int(2, "Line Width", minval = 1, maxval = 5, group = GRP_APPEARANCE, tooltip = "Thickness of the visible trend line.")
int bandFillTransparencyInput = input.int(70, "Line Side", minval = 0, maxval = 100, inline = "fillGradient", group = GRP_APPEARANCE)
int priceFillTransparencyInput = input.int(95, "Price Side", minval = 0, maxval = 100, inline = "fillGradient", group = GRP_APPEARANCE, tooltip = "Line Side controls how strong the color is beside the trend line. Price Side controls how much it fades near price. 0 is solid and 100 is invisible.")
color bearishColorInput = input.color(#ff1100, "Downtrend", inline = "colors", group = GRP_APPEARANCE)
color bullishColorInput = input.color(#00ffbb, "Uptrend", inline = "colors", group = GRP_APPEARANCE, tooltip = "Downtrend controls the color used when price is moving down. Uptrend controls the color used when price is moving up.")

bool showLearningProfileInput = input.bool(true, "Show Pullback Map", group = GRP_PROFILE, tooltip = "Green shows pullbacks seen during uptrends. Red shows pullbacks seen during downtrends. Higher means a bigger pullback, wider means it happened more often, colored lines show the usual room, and the diamond shows the current pullback.")
int learningProfileWidthInput = input.int(18, "Map Width", minval = 5, maxval = 60, inline = "profileLayout", group = GRP_PROFILE)
int learningProfileOffsetInput = input.int(42, "Map Offset", minval = 1, maxval = 200, inline = "profileLayout", group = GRP_PROFILE, tooltip = "Map Width controls how wide each side can grow. Map Offset controls the empty space between the latest candle and the map.")

bool showDashboardInput = input.bool(true, "Show Quick Read", group = GRP_DASHBOARD, tooltip = "Shows three simple answers: which way price is trending, how much pullback room the trend line allows, and whether the script has learned enough examples.")
string dashboardPositionInput = input.string("top right", "Position", options = ["bottom center", "bottom left", "bottom right", "middle center", "middle left", "middle right", "top center", "top left", "top right"], group = GRP_DASHBOARD, tooltip = "Chart location where the dashboard table is anchored.")
string dashboardTextSizeInput = input.string("Small", "Text Size", options = ["Tiny", "Small", "Medium", "Large"], group = GRP_DASHBOARD, tooltip = "Text size used in the Quick Read table.")

// functions

clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

getDashboardPosition(string positionName) =>
    switch positionName
        "bottom center" => position.bottom_center
        "bottom left" => position.bottom_left
        "bottom right" => position.bottom_right
        "middle center" => position.middle_center
        "middle left" => position.middle_left
        "middle right" => position.middle_right
        "top center" => position.top_center
        "top left" => position.top_left
        => position.top_right

getDashboardTextSize(string sizeName) =>
    switch sizeName
        "Tiny" => size.tiny
        "Small" => size.small
        "Medium" => size.normal
        => size.large

dashboardCellAlpha(float confidence) =>
    na(confidence) ? 88 : int(math.round(88.0 - math.min(1.0, math.max(0.0, confidence)) * 38.0))

arrayPercentile(array<float> values, float percentage) =>
    float result = na
    int count = array.size(values)
    if count > 0
        array<float> orderedValues = array.copy(values)
        array.sort(orderedValues, order.ascending)
        float boundedPercentage = clamp(percentage, 0.0, 100.0)
        float rank = boundedPercentage * 0.01 * float(count - 1)
        int lowerIndex = int(math.floor(rank))
        int upperIndex = int(math.ceil(rank))
        float lowerValue = array.get(orderedValues, lowerIndex)
        float upperValue = array.get(orderedValues, upperIndex)
        float interpolationWeight = rank - float(lowerIndex)
        result := lowerValue + (upperValue - lowerValue) * interpolationWeight
    result

pushRollingSample(array<float> sampleBuffer, float sample, int maximumSize) =>
    if not na(sample)
        array.push(sampleBuffer, sample)
        while array.size(sampleBuffer) > maximumSize
            array.shift(sampleBuffer)

var array<float> bullishAdverseSamples = array.new_float()
var array<float> bearishAdverseSamples = array.new_float()

float atr = ta.atr(atrLengthInput)
float bounceBandWidth = ta.sma(ta.tr(true), atrLengthInput)
bool validAtr = not na(atr) and atr > 0.0
float bullishObservedQuantile = arrayPercentile(bullishAdverseSamples, quantileInput)
float bearishObservedQuantile = arrayPercentile(bearishAdverseSamples, quantileInput)
int requiredSamples = math.max(1, math.min(minimumSamplesInput, sampleLengthInput))
float bullishSampleConfidence = math.min(float(array.size(bullishAdverseSamples)) / float(requiredSamples), 1.0)
float bearishSampleConfidence = math.min(float(array.size(bearishAdverseSamples)) / float(requiredSamples), 1.0)
float boundedBullishObservation = clamp(nz(bullishObservedQuantile, fallbackFactorInput), minimumFactorInput, maximumFactorInput)
float boundedBearishObservation = clamp(nz(bearishObservedQuantile, fallbackFactorInput), minimumFactorInput, maximumFactorInput)
float bullishFactorTarget = fallbackFactorInput * (1.0 - bullishSampleConfidence) + boundedBullishObservation * bullishSampleConfidence
float bearishFactorTarget = fallbackFactorInput * (1.0 - bearishSampleConfidence) + boundedBearishObservation * bearishSampleConfidence
float bullishFactor = ta.ema(bullishFactorTarget, factorSmoothingInput)
float bearishFactor = ta.ema(bearishFactorTarget, factorSmoothingInput)

float rawLowerBand = validAtr ? sourceInput - bullishFactor * atr : na
float rawUpperBand = validAtr ? sourceInput + bearishFactor * atr : na

var float lowerBand = na
var float upperBand = na
var int trend = 0

float previousLowerBand = lowerBand[1]
float previousUpperBand = upperBand[1]

lowerBand := na(previousLowerBand) ? rawLowerBand : rawLowerBand > previousLowerBand or close[1] < previousLowerBand ? rawLowerBand : previousLowerBand
upperBand := na(previousUpperBand) ? rawUpperBand : rawUpperBand < previousUpperBand or close[1] > previousUpperBand ? rawUpperBand : previousUpperBand

int previousTrend = nz(trend[1], 0)

if not validAtr
    trend := previousTrend
else if previousTrend == 0
    trend := close >= sourceInput ? 1 : -1
else if previousTrend == 1
    trend := close < lowerBand ? -1 : 1
else
    trend := close > upperBand ? 1 : -1

float superTrend = trend == 1 ? lowerBand : trend == -1 ? upperBand : na
bool bullishShift = trend == 1 and previousTrend == -1 and barstate.isconfirmed
bool bearishShift = trend == -1 and previousTrend == 1 and barstate.isconfirmed

var float trendExtreme = na

if trend == 0
    trendExtreme := na
else if trend != previousTrend or na(trendExtreme[1])
    trendExtreme := trend == 1 ? high : low
else
    trendExtreme := trend == 1 ? math.max(trendExtreme[1], high) : math.min(trendExtreme[1], low)

float bullishAdverseExcursion = validAtr and trend == 1 ? math.max(trendExtreme - low, 0.0) / atr : na
float bearishAdverseExcursion = validAtr and trend == -1 ? math.max(high - trendExtreme, 0.0) / atr : na
bool establishedBullishBar = barstate.isconfirmed and trend == 1 and previousTrend == 1
bool establishedBearishBar = barstate.isconfirmed and trend == -1 and previousTrend == -1

if establishedBullishBar
    pushRollingSample(bullishAdverseSamples, bullishAdverseExcursion, sampleLengthInput)

if establishedBearishBar
    pushRollingSample(bearishAdverseSamples, bearishAdverseExcursion, sampleLengthInput)

// visuals

color activeTrendColor = trend == 1 ? bullishColorInput : bearishColorInput
float bullishLine = showBandsInput and trend == 1 ? superTrend : na
float bearishLine = showBandsInput and trend == -1 ? superTrend : na
float bullishBounceLine = showBandsInput and trend == 1 and not na(bounceBandWidth) ? math.max(superTrend, math.min(superTrend + bounceBandWidth, sourceInput)) : na
float bearishBounceLine = showBandsInput and trend == -1 and not na(bounceBandWidth) ? math.min(superTrend, math.max(superTrend - bounceBandWidth, sourceInput)) : na
bool bullishBounceReaction = barstate.isconfirmed and trend == 1 and previousTrend == 1 and not na(bullishBounceLine) and not na(bullishBounceLine[1]) and close > bullishBounceLine and close[1] <= bullishBounceLine[1] and close[1] >= superTrend[1]
bool bearishBounceReaction = barstate.isconfirmed and trend == -1 and previousTrend == -1 and not na(bearishBounceLine) and not na(bearishBounceLine[1]) and close < bearishBounceLine and close[1] >= bearishBounceLine[1] and close[1] <= superTrend[1]

bullishPlot = plot(bullishLine, "Uptrend Line", color = bullishColorInput, linewidth = lineWidthInput, style = plot.style_linebr)
bearishPlot = plot(bearishLine, "Downtrend Line", color = bearishColorInput, linewidth = lineWidthInput, style = plot.style_linebr)
bullishBouncePlot = plot(bullishBounceLine, "Uptrend Bounce Line", color = bullishColorInput, linewidth = 1, style = plot.style_linebr)
bearishBouncePlot = plot(bearishBounceLine, "Downtrend Bounce Line", color = bearishColorInput, linewidth = 1, style = plot.style_linebr)
bodyMiddlePlot = plot(barstate.isfirst ? na : (open + close) * 0.5, "Body Middle", display = display.none)

fill(bodyMiddlePlot, bullishPlot, (open + close) / 2, superTrend, showFillInput ? color.new(bullishColorInput, priceFillTransparencyInput) : na, showFillInput ? color.new(bullishColorInput, bandFillTransparencyInput) : na)
fill(bodyMiddlePlot, bearishPlot, superTrend, (open + close) / 2, showFillInput ? color.new(bearishColorInput, bandFillTransparencyInput) : na, showFillInput ? color.new(bearishColorInput, priceFillTransparencyInput) : na)
fill(bullishBouncePlot, bullishPlot, bullishBounceLine, bullishLine, showFillInput ? color.new(bullishColorInput, 50) : na, showFillInput ? color.new(bullishColorInput, 50) : na)
fill(bearishPlot, bearishBouncePlot, bearishLine, bearishBounceLine, showFillInput ? color.new(bearishColorInput, 50) : na, showFillInput ? color.new(bearishColorInput, 50) : na)

plotshape(showSignalsInput and bullishShift ? superTrend : na, title = "Trend Turns Up", style = shape.labelup, location = location.absolute, color = bullishColorInput, text = "▲", textcolor = color.white, size = size.small)
plotshape(showSignalsInput and bearishShift ? superTrend : na, title = "Trend Turns Down", style = shape.labeldown, location = location.absolute, color = bearishColorInput, text = "▼", textcolor = color.white, size = size.small)
plotchar(showSignalsInput and bullishBounceReaction ? superTrend - bounceBandWidth * 0.5 : na, title = "Price Bounces Up", char = "▲", location = location.absolute, color = bullishColorInput, size = size.tiny)
plotchar(showSignalsInput and bearishBounceReaction ? superTrend + bounceBandWidth * 0.5 : na, title = "Price Bounces Down", char = "▼", location = location.absolute, color = bearishColorInput, size = size.tiny)

barcolor(colorBarsInput and trend != 0 ? color.new(activeTrendColor, 55) : na)

plot(bullishFactor, "Uptrend Pullback Room", display = display.data_window)
plot(bearishFactor, "Downtrend Pullback Room", display = display.data_window)
plot(bullishSampleConfidence, "Uptrend Learning Progress", display = display.data_window)
plot(bearishSampleConfidence, "Downtrend Learning Progress", display = display.data_window)

var array<box> bullishProfileBoxes = array.new<box>()
var array<box> bearishProfileBoxes = array.new<box>()
var line profileAxisLine = na
var line bullishFactorLine = na
var line bearishFactorLine = na
var label profileTitleLabel = na
var label profileBottomLabel = na
var label bullishFactorLabel = na
var label bearishFactorLabel = na
var label activeExcursionLabel = na

if array.size(bullishProfileBoxes) == 0
    for i = 0 to PROFILE_BIN_COUNT - 1
        array.push(bullishProfileBoxes, box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = na))
        array.push(bearishProfileBoxes, box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = na))

bool learningProfileReady = showLearningProfileInput and validAtr and (array.size(bullishAdverseSamples) > 0 or array.size(bearishAdverseSamples) > 0)

if barstate.islast and learningProfileReady
    float profileMaximumFactor = math.max(maximumFactorInput, 0.01)
    float profileBinStep = profileMaximumFactor / PROFILE_BIN_COUNT
    float profileBottom = close - profileMaximumFactor * atr * 0.5
    float profileTop = profileBottom + profileMaximumFactor * atr
    int profileCenter = bar_index + learningProfileOffsetInput + learningProfileWidthInput
    int profileLeft = profileCenter - learningProfileWidthInput
    int profileRight = profileCenter + learningProfileWidthInput
    array<int> bullishProfileCounts = array.new_int(PROFILE_BIN_COUNT, 0)
    array<int> bearishProfileCounts = array.new_int(PROFILE_BIN_COUNT, 0)

    if array.size(bullishAdverseSamples) > 0
        for sampleIndex = 0 to array.size(bullishAdverseSamples) - 1
            float sample = array.get(bullishAdverseSamples, sampleIndex)
            int binIndex = math.max(0, math.min(PROFILE_BIN_COUNT - 1, int(math.floor(sample / profileBinStep))))
            array.set(bullishProfileCounts, binIndex, array.get(bullishProfileCounts, binIndex) + 1)

    if array.size(bearishAdverseSamples) > 0
        for sampleIndex = 0 to array.size(bearishAdverseSamples) - 1
            float sample = array.get(bearishAdverseSamples, sampleIndex)
            int binIndex = math.max(0, math.min(PROFILE_BIN_COUNT - 1, int(math.floor(sample / profileBinStep))))
            array.set(bearishProfileCounts, binIndex, array.get(bearishProfileCounts, binIndex) + 1)

    int maximumBinCount = 0
    for i = 0 to PROFILE_BIN_COUNT - 1
        maximumBinCount := math.max(maximumBinCount, math.max(array.get(bullishProfileCounts, i), array.get(bearishProfileCounts, i)))

    for i = 0 to PROFILE_BIN_COUNT - 1
        int bullishCount = array.get(bullishProfileCounts, i)
        int bearishCount = array.get(bearishProfileCounts, i)
        int bullishLength = bullishCount > 0 and maximumBinCount > 0 ? math.max(1, int(math.round(float(bullishCount) / maximumBinCount * learningProfileWidthInput))) : 0
        int bearishLength = bearishCount > 0 and maximumBinCount > 0 ? math.max(1, int(math.round(float(bearishCount) / maximumBinCount * learningProfileWidthInput))) : 0
        int bullishTransparency = bullishCount > 0 and maximumBinCount > 0 ? 90 - int(math.round(float(bullishCount) / maximumBinCount * 50.0)) : 100
        int bearishTransparency = bearishCount > 0 and maximumBinCount > 0 ? 90 - int(math.round(float(bearishCount) / maximumBinCount * 50.0)) : 100
        float binBottom = profileBottom + profileBinStep * i * atr
        float binTop = profileBottom + profileBinStep * (i + 1) * atr
        box bullishProfileBox = array.get(bullishProfileBoxes, i)
        box.set_left(bullishProfileBox, profileCenter - bullishLength)
        box.set_right(bullishProfileBox, profileCenter)
        box.set_top(bullishProfileBox, binTop)
        box.set_bottom(bullishProfileBox, binBottom)
        box.set_bgcolor(bullishProfileBox, bullishCount > 0 ? color.new(bullishColorInput, bullishTransparency) : na)
        box.set_border_color(bullishProfileBox, na)
        box bearishProfileBox = array.get(bearishProfileBoxes, i)
        box.set_left(bearishProfileBox, profileCenter)
        box.set_right(bearishProfileBox, profileCenter + bearishLength)
        box.set_top(bearishProfileBox, binTop)
        box.set_bottom(bearishProfileBox, binBottom)
        box.set_bgcolor(bearishProfileBox, bearishCount > 0 ? color.new(bearishColorInput, bearishTransparency) : na)
        box.set_border_color(bearishProfileBox, na)

    float bullishFactorY = profileBottom + clamp(bullishFactor, 0.0, profileMaximumFactor) * atr
    float bearishFactorY = profileBottom + clamp(bearishFactor, 0.0, profileMaximumFactor) * atr
    float activeExcursion = trend == 1 ? bullishAdverseExcursion : trend == -1 ? bearishAdverseExcursion : na
    float activeExcursionY = profileBottom + clamp(nz(activeExcursion), 0.0, profileMaximumFactor) * atr
    int activeExcursionX = trend == 1 ? profileCenter - 1 : profileCenter + 1

    if na(profileAxisLine)
        profileAxisLine := line.new(profileCenter, profileBottom, profileCenter, profileTop, color = color.new(chart.fg_color, 65), width = 1)
        bullishFactorLine := line.new(profileLeft, bullishFactorY, profileCenter, bullishFactorY, color = bullishColorInput, width = 2)
        bearishFactorLine := line.new(profileCenter, bearishFactorY, profileRight, bearishFactorY, color = bearishColorInput, width = 2)
    else
        line.set_xy1(profileAxisLine, profileCenter, profileBottom)
        line.set_xy2(profileAxisLine, profileCenter, profileTop)
        line.set_xy1(bullishFactorLine, profileLeft, bullishFactorY)
        line.set_xy2(bullishFactorLine, profileCenter, bullishFactorY)
        line.set_xy1(bearishFactorLine, profileCenter, bearishFactorY)
        line.set_xy2(bearishFactorLine, profileRight, bearishFactorY)

    string profileTitle = "BIGGER PULLBACKS ↑\nWider bars = happened more often"
    string bullishFactorText = "UP TRENDS\nUsual room " + str.tostring(bullishFactor, "#.00") + "× normal move"
    string bearishFactorText = "DOWN TRENDS\nUsual room " + str.tostring(bearishFactor, "#.00") + "× normal move"

    if na(profileTitleLabel)
        profileTitleLabel := label.new(profileCenter, profileTop + atr * 0.25, profileTitle, style = label.style_label_down, textcolor = chart.fg_color, color = chart.bg_color, size = size.normal)
        profileBottomLabel := label.new(profileCenter, profileBottom - atr * 0.15, "SMALLER PULLBACKS", style = label.style_label_up, textcolor = color.new(chart.fg_color, 25), color = chart.bg_color, size = size.small)
        bullishFactorLabel := label.new(profileLeft, bullishFactorY, bullishFactorText, style = label.style_label_right, textcolor = bullishColorInput, color = chart.bg_color, size = size.small)
        bearishFactorLabel := label.new(profileRight, bearishFactorY, bearishFactorText, style = label.style_label_left, textcolor = bearishColorInput, color = chart.bg_color, size = size.small)
        activeExcursionLabel := label.new(activeExcursionX, activeExcursionY, "◆ NOW", style = label.style_none, textcolor = activeTrendColor, size = size.normal)
    else
        label.set_xy(profileTitleLabel, profileCenter, profileTop + atr * 0.25)
        label.set_text(profileTitleLabel, profileTitle)
        label.set_xy(profileBottomLabel, profileCenter, profileBottom - atr * 0.15)
        label.set_xy(bullishFactorLabel, profileLeft, bullishFactorY)
        label.set_text(bullishFactorLabel, bullishFactorText)
        label.set_xy(bearishFactorLabel, profileRight, bearishFactorY)
        label.set_text(bearishFactorLabel, bearishFactorText)
        label.set_xy(activeExcursionLabel, activeExcursionX, activeExcursionY)
        label.set_textcolor(activeExcursionLabel, activeTrendColor)
else if barstate.islast
    for i = 0 to PROFILE_BIN_COUNT - 1
        box.set_bgcolor(array.get(bullishProfileBoxes, i), na)
        box.set_border_color(array.get(bullishProfileBoxes, i), na)
        box.set_bgcolor(array.get(bearishProfileBoxes, i), na)
        box.set_border_color(array.get(bearishProfileBoxes, i), na)
    if not na(profileAxisLine)
        line.delete(profileAxisLine)
        line.delete(bullishFactorLine)
        line.delete(bearishFactorLine)
        profileAxisLine := na
        bullishFactorLine := na
        bearishFactorLine := na
    if not na(profileTitleLabel)
        label.delete(profileTitleLabel)
        label.delete(profileBottomLabel)
        label.delete(bullishFactorLabel)
        label.delete(bearishFactorLabel)
        label.delete(activeExcursionLabel)
        profileTitleLabel := na
        profileBottomLabel := na
        bullishFactorLabel := na
        bearishFactorLabel := na
        activeExcursionLabel := na

var table dashboard = na
var string dashboardPositionLast = na
var string dashboardTextSizeLast = na

if barstate.islast
    if showDashboardInput
        bool recreateDashboard = na(dashboard) or dashboardPositionLast != dashboardPositionInput or dashboardTextSizeLast != dashboardTextSizeInput
        if recreateDashboard
            if not na(dashboard)
                table.delete(dashboard)
            dashboard := table.new(position = getDashboardPosition(dashboardPositionInput), columns = 2, rows = 4, bgcolor = chart.bg_color, border_width = 1, border_color = chart.fg_color, frame_color = chart.fg_color, frame_width = 1)
            dashboardPositionLast := dashboardPositionInput
            dashboardTextSizeLast := dashboardTextSizeInput

        table.clear(dashboard, 0, 0, 1, 3)

        dashboardSize = getDashboardTextSize(dashboardTextSizeInput)
        string trendText = trend == 1 ? "UP ▲" : trend == -1 ? "DOWN ▼" : "WAITING"
        float activeFactor = trend == 1 ? bullishFactor : trend == -1 ? bearishFactor : na
        float activeConfidence = trend == 1 ? bullishSampleConfidence : trend == -1 ? bearishSampleConfidence : na
        int activeSampleCount = trend == 1 ? array.size(bullishAdverseSamples) : trend == -1 ? array.size(bearishAdverseSamples) : 0
        color activeCellColor = trend == 0 ? chart.bg_color : color.new(activeTrendColor, dashboardCellAlpha(activeConfidence))
        color learningCellColor = na(activeConfidence) ? chart.bg_color : activeConfidence >= 1.0 ? color.new(activeTrendColor, 55) : color.new(chart.fg_color, 88)
        string pullbackRoomText = na(activeFactor) ? "—" : str.tostring(activeFactor, "#.00") + "× normal move"
        string learningText = trend == 0 ? "Waiting for a trend" : activeConfidence >= 1.0 ? "READY · " + str.tostring(activeSampleCount) + " examples" : "LEARNING · " + str.tostring(activeSampleCount) + " of " + str.tostring(requiredSamples)

        table.cell(dashboard, 0, 0, "WHAT IT MEANS", text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize)
        table.cell(dashboard, 1, 0, "RIGHT NOW", text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize)
        table.cell(dashboard, 0, 1, "Price is trending", text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize)
        table.cell(dashboard, 1, 1, trendText, text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize, bgcolor = activeCellColor)
        table.cell(dashboard, 0, 2, "Pullback room", text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize)
        table.cell(dashboard, 1, 2, pullbackRoomText, text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize, bgcolor = activeCellColor)
        table.cell(dashboard, 0, 3, "Learning status", text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize)
        table.cell(dashboard, 1, 3, learningText, text_color = chart.fg_color, text_halign = text.align_center, text_size = dashboardSize, bgcolor = learningCellColor)
    else if not na(dashboard)
        table.delete(dashboard)
        dashboard := na
        dashboardPositionLast := na
        dashboardTextSizeLast := na

//Alerts
alertcondition(bullishShift, title = "Trend Turns Up", message = "Trend turned up on {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")
alertcondition(bearishShift, title = "Trend Turns Down", message = "Trend turned down on {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")
alertcondition(bullishShift or bearishShift, title = "Trend Changes Direction", message = "Trend changed direction on {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")
alertcondition(bullishBounceReaction, title = "Price Bounces Up", message = "Price bounced up from the trend zone on {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")
alertcondition(bearishBounceReaction, title = "Price Bounces Down", message = "Price bounced down from the trend zone on {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")
